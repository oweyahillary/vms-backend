# ── DATABASE ───────────────────────────────────────────────────────────
# Use Session Mode pooler URL from Supabase (Settings > Database > Session Mode)
DATABASE_URL=postgresql://postgres.xxxx:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── SUPABASE STORAGE ───────────────────────────────────────────────────
# From Supabase > Settings > API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-anon-public-key

# ── JWT ────────────────────────────────────────────────────────────────
# Any long random string — keep this secret, never commit it
JWT_SECRET=VivoVMS-Change-This-To-Something-Long-And-Random-2024
